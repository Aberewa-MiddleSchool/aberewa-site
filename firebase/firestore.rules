rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isTeacher() {
      return signedIn() && request.auth.uid == "rq8Z1su8FNe1O1ETJgB4jjI0Sxx2";
    }
    function own(uid) { return signedIn() && request.auth.uid == uid; }
    // One verified teacher administrator UID; never use email alone for authorization.
    match /profiles/{uid} {
      allow get: if own(uid) || isTeacher();
      allow list: if isTeacher();
      allow write: if false;
    }
    // Students submit immutable response choices, never client-computed grades.
    // The teacher view calculates formative scores from its answer key.
    match /scores/{uid}/attempts/{attemptId} {
      allow get, list: if own(uid) || isTeacher();
      allow create: if own(uid) &&
        exists(/databases/$(database)/documents/profiles/$(uid)) &&
        get(/databases/$(database)/documents/profiles/$(uid)).data.role == 'student' &&
        request.resource.data.keys().hasAll(['day', 'week', 'answers', 'recordedAt']) &&
        request.resource.data.keys().hasOnly(['day', 'week', 'answers', 'recordedAt']) &&
        request.resource.data.day is int &&
        request.resource.data.day >= 1 &&
        request.resource.data.day <= 10 &&
        request.resource.data.week is int &&
        request.resource.data.week == (request.resource.data.day <= 5 ? 1 : 2) &&
        request.resource.data.answers is list &&
        request.resource.data.answers.size() == (request.resource.data.day == 5 || request.resource.data.day == 10 ? 5 : 3) &&
        request.resource.data.recordedAt == request.time;
      allow update, delete: if false;
    }
  }
}
