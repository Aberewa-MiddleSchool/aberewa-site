rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    // Privileges come from Firebase Auth custom claims assigned with Admin SDK,
    // never from client-controlled fields or profile documents.
    function isTeacher() {
      return signedIn() && request.auth.token.teacher == true;
    }
    function isApprovedStudent() {
      return signedIn() && request.auth.token.student == true &&
        request.auth.token.teacher != true;
    }
    function isOwnApprovedStudent(uid) {
      return isApprovedStudent() && request.auth.uid == uid;
    }

    match /profiles/{uid} {
      allow get: if isOwnApprovedStudent(uid) || isTeacher();
      allow list: if isTeacher();
      allow create, update, delete: if false;
    }

    match /scores/{uid}/attempts/{attemptId} {
      allow get, list: if isOwnApprovedStudent(uid) || isTeacher();
      // Student-submitted formative scores only. These are NOT verified grades.
      allow create: if isOwnApprovedStudent(uid) &&
        exists(/databases/$(database)/documents/profiles/$(uid)) &&
        get(/databases/$(database)/documents/profiles/$(uid)).data.role == 'student' &&
        request.resource.data.keys().hasAll([
          'day','week','score','correct','total','attempts','missed','recordedAt'
        ]) &&
        request.resource.data.keys().hasOnly([
          'day','week','score','correct','total','attempts','missed','recordedAt'
        ]) &&
        request.resource.data.day is int &&
        request.resource.data.day >= 1 && request.resource.data.day <= 10 &&
        request.resource.data.week is int &&
        request.resource.data.week >= 1 && request.resource.data.week <= 2 &&
        ((request.resource.data.day <= 5 && request.resource.data.week == 1) ||
         (request.resource.data.day >= 6 && request.resource.data.week == 2)) &&
        request.resource.data.score is int &&
        request.resource.data.score >= 0 && request.resource.data.score <= 100 &&
        request.resource.data.correct is int &&
        request.resource.data.total is int &&
        request.resource.data.total >= 1 && request.resource.data.total <= 5 &&
        request.resource.data.correct >= 0 &&
        request.resource.data.correct <= request.resource.data.total &&
        request.resource.data.score >= (request.resource.data.correct * 100 / request.resource.data.total) - 1 &&
        request.resource.data.score <= (request.resource.data.correct * 100 / request.resource.data.total) + 1 &&
        request.resource.data.attempts is int &&
        request.resource.data.attempts >= 1 &&
        request.resource.data.attempts <= 10000 &&
        request.resource.data.missed is list &&
        request.resource.data.missed.size() <= 5 &&
        request.resource.data.recordedAt == request.time;
      allow update, delete: if false;
    }
    // Deny all other collections and document paths by default.
    match /{document=**} { allow read, write: if false; }
  }
}
